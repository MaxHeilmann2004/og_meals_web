{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "~": ["app"],
      "~/*": ["app/*"],
      "@": ["app"],
      "@/*": ["app/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "./shims.d.ts",
    "../playwright.config.ts",
    "../vitest.config.ts"
  ]
}
